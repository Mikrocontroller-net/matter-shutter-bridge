# M5Stack AtomS3 Lite: ESP32-S3FN8, 8 MB flash, no PSRAM, console on USB-Serial-JTAG
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Each device draws its own setup code (main/setup_code.cpp) instead of the
# SDK's public test code
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y

# BLE commissioning
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Root + aggregator + 8 shutters, with room for room covers and stop switches
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=20

CONFIG_ENABLE_CHIP_SHELL=y
# Vendor and product name shown for the bridge
CONFIG_CHIP_PROJECT_CONFIG="main/matter_project_config.h"
# Console commands print tables; 2 KB default is too small
CONFIG_ESP_MATTER_CONSOLE_TASK_STACK=4096
# Matter data model creation and settings load run on the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
# MAX_FABRIC unique local addresses plus one link-local address
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Remote development (main/remote.cpp). New firmware that crashes or does not
# reach Wi-Fi is rolled back; the bootloader needs one USB flash for this.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# DHCP host name, which many home routers resolve
CONFIG_LWIP_LOCAL_HOSTNAME="shutter-bridge"
# Matter's sockets plus the HTTP server's three connections, listener and
# control socket
CONFIG_LWIP_MAX_SOCKETS=16
